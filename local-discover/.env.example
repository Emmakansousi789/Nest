# Database (Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="YOUR_RANDOM_SECRET_HERE_generate_with_openssl_rand_base64_32"

# Capacitor native app — set to your Vercel deployment URL
# This tells the native app where to load the web UI and API from.
# Leave unset for local static export builds.
# CAPACITOR_API_URL="https://your-app.vercel.app"

