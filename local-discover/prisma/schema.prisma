generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth (NextAuth Prisma Adapter compatible) ───

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  password      String?   // for credentials provider
  image         String?
  role          UserRole  @default(CUSTOMER)

  accounts  Account[]
  sessions  Session[]
  favorites Favorite[]
  reviews   Review[]
  messages  Message[]   @relation("sentMessages")
  ownedVendors Vendor[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum UserRole {
  CUSTOMER
  BUSINESS
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Domain Models ───

model Vendor {
  id          String         @id
  name        String
  tagline     String
  story       String
  category    String         // BusinessCategory enum value
  tags        String[]       // BusinessTag array
  address     String
  city        String
  state       String
  zip         String
  lat         Float
  lng         Float
  phone       String
  email       String
  website     String?
  instagram   String?
  hours       Json           // OperatingHours object
  photos      Json[]         // VendorPhoto[]
  products    Json[]         // Product[]
  featured    Boolean        @default(false)
  verified    Boolean        @default(false)
  joinedDate  DateTime       @default(now())
  ownerId     String?

  owner       User?          @relation(fields: [ownerId], references: [id])
  reviews     Review[]
  messages    Message[]
  favorites   Favorite[]

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([city])
  @@index([state])
  @@index([category])
  @@index([lat, lng])
}

model Review {
  id         String   @id @default(cuid())
  vendorId   String
  authorId   String
  authorName String
  rating     Int      // 0-5
  text       String
  response   Json?    // { text: string, date: string }

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vendorId])
  @@index([authorId])
}

model Message {
  id         String   @id @default(cuid())
  vendorId   String
  senderId   String
  senderName String
  text       String
  read       Boolean  @default(false)
  response   Json?    // { text: string, date: string }

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  sender User   @relation("sentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vendorId])
  @@index([senderId])
}

model Favorite {
  id        String @id @default(cuid())
  userId    String
  vendorId  String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, vendorId])
  @@index([userId])
  @@index([vendorId])
}
